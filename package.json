{
  "name": "nijimi",
  "version": "0.1.0",
  "description": "nijimi（滲み）·。轻量级 diorama 渲染引擎（three.js）：契约化角色资产 + NPR 着色 + 编辑器 + 资产管线",
  "type": "module",
  "license": "ISC",
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./vite.mjs"
  },
